	     caused the original NullReferenceException crash. The real fix for that control lives in
	     Project Z's own windows.xml instead (relocated into itemActions). -->

	<append xpath="//window[@name='craftingInfoPanel']/rect[@name='contentCraftingInfo']">
		<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="354,0" width="${parentinnerwidth - 147 - 2 - 214}" height="46" color="[black]" type="sliced" fillcenter="false" />
	</append>
	<set xpath="//window[@name='craftingInfoPanel']/rect[@name='contentCraftingInfo']/rect[@name='preview']/@width">180</set>
